# Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=Compiled Tech <hello@compiledtech.io>
# Optional: direct URL to a PNG/WebP logo shown in contact-form emails.
# SVG is not rendered by most email clients. Without it, emails use a text mark.
# EMAIL_LOGO_URL=https://your-supabase-storage.../logo.png

# Supabase
# Server-only (API routes): service role key bypasses RLS. Never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public (browser admin auth): these get embedded in the client bundle at build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site
# Canonical origin for SEO/sitemap/OG and the admin sign-out redirect.
NEXT_PUBLIC_SITE_URL=https://compiledtech.io

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cal.com
# Paste the public event URL from Cal.com, for example:
# https://cal.com/your-username/30min
NEXT_PUBLIC_CALCOM_URL=
